<mxfile host="app.diagrams.net"><diagram id="architecture" name="AWS architecture"><mxGraphModel page="1" pageWidth="1200" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="C1" parent="1" vertex="1" value="Route 53&#10;Amazon Route 53" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="40" width="270" height="100" as="geometry" /></mxCell><mxCell id="C2" parent="1" vertex="1" value="WAF&#10;AWS WAF with managed rule groups" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="400" y="40" width="270" height="100" as="geometry" /></mxCell><mxCell id="C3" parent="1" vertex="1" value="ALB&#10;Application Load Balancer, HTTPS listener with ACM certificate, OIDC action" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="760" y="40" width="270" height="100" as="geometry" /></mxCell><mxCell id="C4" parent="1" vertex="1" value="ECS Fargate&#10;Amazon ECS on Fargate, 2+ tasks in private subnets" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="220" width="270" height="100" as="geometry" /></mxCell><mxCell id="C5" parent="1" vertex="1" value="Cognito&#10;Amazon Cognito user pool, federated to XATA IdP if available" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="400" y="220" width="270" height="100" as="geometry" /></mxCell><mxCell id="C6" parent="1" vertex="1" value="RDS PostgreSQL&#10;Amazon RDS for PostgreSQL, Multi-AZ, automated backups with PITR" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="760" y="220" width="270" height="100" as="geometry" /></mxCell><mxCell id="C7" parent="1" vertex="1" value="Secrets Manager&#10;AWS Secrets Manager" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="400" width="270" height="100" as="geometry" /></mxCell><mxCell id="C8" parent="1" vertex="1" value="KMS&#10;AWS KMS customer managed keys" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="400" y="400" width="270" height="100" as="geometry" /></mxCell><mxCell id="C9" parent="1" vertex="1" value="AWS Backup&#10;AWS Backup vault with RDS backup plan" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="760" y="400" width="270" height="100" as="geometry" /></mxCell><mxCell id="C10" parent="1" vertex="1" value="CloudWatch&#10;CloudWatch Logs, metrics, alarms, Synthetics canary, CloudTrail" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="580" width="270" height="100" as="geometry" /></mxCell><mxCell id="E1" parent="1" edge="1" source="C1" target="C3" value="DNS resolves the app name to the ALB." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E2" parent="1" edge="1" source="C2" target="C3" value="WAF inspects inbound requests on the ALB." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E3" parent="1" edge="1" source="C3" target="C5" value="ALB runs the OIDC login flow with Cognito." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E4" parent="1" edge="1" source="C3" target="C4" value="HTTPS forwarding of authenticated requests to healthy tasks." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E5" parent="1" edge="1" source="C4" target="C6" value="App reads and writes TODO data over TLS." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E6" parent="1" edge="1" source="C4" target="C7" value="Task role reads DB credentials at startup or rotation." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E7" parent="1" edge="1" source="C7" target="C8" value="Secret values encrypted with KMS." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E8" parent="1" edge="1" source="C6" target="C8" value="Database storage and snapshots encrypted with KMS." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E9" parent="1" edge="1" source="C6" target="C9" value="Snapshots and backup copies protected in the vault." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E10" parent="1" edge="1" source="C9" target="C8" value="Vault encrypted with KMS." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E11" parent="1" edge="1" source="C3" target="C10" value="ALB metrics and access logs." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E12" parent="1" edge="1" source="C4" target="C10" value="App logs with request IDs, metrics and alarms." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E13" parent="1" edge="1" source="C6" target="C10" value="Database metrics and alarms." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
