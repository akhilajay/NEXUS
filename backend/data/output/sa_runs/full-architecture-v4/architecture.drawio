<mxfile host="app.diagrams.net"><diagram id="architecture" name="AWS architecture"><mxGraphModel page="1" pageWidth="1200" pageHeight="1400"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="C1" parent="1" vertex="1" value="CloudFront + WAF&#10;Amazon CloudFront, AWS WAF" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="40" width="270" height="100" as="geometry" /></mxCell><mxCell id="C2" parent="1" vertex="1" value="Load balancer&#10;Application Load Balancer with ACM certificate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="400" y="40" width="270" height="100" as="geometry" /></mxCell><mxCell id="C3" parent="1" vertex="1" value="App compute&#10;Amazon ECS on AWS Fargate" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="760" y="40" width="270" height="100" as="geometry" /></mxCell><mxCell id="C4" parent="1" vertex="1" value="Database&#10;Amazon RDS for PostgreSQL, Multi-AZ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="220" width="270" height="100" as="geometry" /></mxCell><mxCell id="C5" parent="1" vertex="1" value="Authentication&#10;Amazon Cognito user pool or federated customer IdP" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="400" y="220" width="270" height="100" as="geometry" /></mxCell><mxCell id="C6" parent="1" vertex="1" value="Secrets&#10;AWS Secrets Manager" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="760" y="220" width="270" height="100" as="geometry" /></mxCell><mxCell id="C7" parent="1" vertex="1" value="Observability&#10;Amazon CloudWatch Logs, metrics and alarms" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="40" y="400" width="270" height="100" as="geometry" /></mxCell><mxCell id="C8" parent="1" vertex="1" value="Backup&#10;AWS Backup with protected vault" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;"><mxGeometry x="400" y="400" width="270" height="100" as="geometry" /></mxCell><mxCell id="E1" parent="1" edge="1" source="C1" target="C2" value="Forwards HTTPS requests to the load balancer." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E2" parent="1" edge="1" source="C2" target="C3" value="Routes requests to healthy ECS tasks in two AZs." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E3" parent="1" edge="1" source="C3" target="C4" value="Reads and writes TODO data over TLS." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E4" parent="1" edge="1" source="C3" target="C5" value="Authenticates users and validates tokens." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E5" parent="1" edge="1" source="C3" target="C6" value="Retrieves database credentials at runtime." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E6" parent="1" edge="1" source="C3" target="C7" value="Sends application logs and metrics." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E7" parent="1" edge="1" source="C4" target="C8" value="Schedules database backups." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="E8" parent="1" edge="1" source="C1" target="C7" value="Sends edge metrics and WAF logs." style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>
